#TESTING PACKAGE CALLED CVEQUALITY
# Use individual means as the raw data for comparing CVs across Strain x Treatment groups
ind_means$group <- interaction(ind_means$Strain, ind_means$Treatment, drop = TRUE)
# Feltz & Miller (1996) asymptotic test
cveq_asym <- asymptotic_test(x = ind_means$mean_len_ind, y = ind_means$group)
