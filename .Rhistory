library(AnnotationDbi)
library(org.Dm.eg.db)
library(KEGGREST)
BiocManager::valid()
# 1) Packages present?
c(
KEGGREST      = requireNamespace("KEGGREST", quietly=TRUE),
AnnotationDbi = requireNamespace("AnnotationDbi", quietly=TRUE),
org.Dm.eg.db  = requireNamespace("org.Dm.eg.db", quietly=TRUE)
)
# 2) Versions (should print cleanly)
sapply(c("KEGGREST","AnnotationDbi","org.Dm.eg.db"), packageVersion)
# 3) org.Dm.eg.db basic sanity: can we list keytypes/columns?
suppressPackageStartupMessages({ library(AnnotationDbi); library(org.Dm.eg.db) })
head(keytypes(org.Dm.eg.db))
head(columns(org.Dm.eg.db))
# 4) Minimal lookup test: does an Entrez ID map to a FlyBase ID?
# (Use a made-up small set; NA is fine for some entries—just verifying the function runs)
test_ids <- c("39745","37279","4267")   # arbitrary Entrez IDs; may or may not map
AnnotationDbi::mapIds(org.Dm.eg.db, keys=test_ids, keytype="ENTREZID",
column="FLYBASE", multiVals="first")
